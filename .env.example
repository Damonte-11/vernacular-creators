# Copy this file to .env.local (for your computer) or add these in Vercel →
# Project → Settings → Environment Variables. Never put real values in GitHub.
# Leave the Supabase lines empty to run the demo on sample data.
# Step-by-step instructions for every value: docs/SETUP.md

# ── Supabase (database + team login) ─────────────────────────────
# Supabase → Project Settings → API Keys (and "Project URL" on the same page / Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key. Server only: keep it private.
SUPABASE_SECRET_KEY=

# ── Instagram (Meta Graph API, Business Discovery) ───────────────
# Vernacular's own Instagram professional account ID and a Page access token.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Optional: Graph API version (defaults to v25.0)
META_GRAPH_API_VERSION=

# ── YouTube (Google Cloud, YouTube Data API v3) ──────────────────
YOUTUBE_API_KEY=

# ── Daily refresh ────────────────────────────────────────────────
# Any long random string. Vercel uses it to call the daily refresh securely.
CRON_SECRET=
